# Floorview Studio — server-side settings for the AI import assistant (POST /api/architect).
# Copy this file to `studio/.env.local` (git-ignored) and fill in your values:
#   cp studio/.env.example studio/.env.local
# These variables are read by the Vite dev/preview server only and are never sent to the browser.
# Restart `npm run dev` after changing them.

# Anthropic API key (create one at https://console.anthropic.com → API Keys).
# Leave empty to use ANTHROPIC_API_KEY from your shell, or an `ant auth login` profile.
ANTHROPIC_API_KEY=

# Set to 1 to use the scripted offline assistant instead of calling Claude
# (no key needed; it does not read the drawing). Same as `npm run dev:mock`.
ARCHITECT_MOCK=0
