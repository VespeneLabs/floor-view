{
  "name": "@vespenelabs/floorview",
  "version": "0.4.2",
  "description": "Floorview: a floor plan viewer (2D/3D) and editor for the web, by VespeneLabs.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VespeneLabs/floor-view.git"
  },
  "type": "module",
  "main": "./dist/vespenelabs-floorview.umd.cjs",
  "module": "./dist/vespenelabs-floorview.js",
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "model": [
        "./dist/types/model/index.d.ts"
      ],
      "architect": [
        "./dist/types/architect/index.d.ts"
      ],
      "architect/server": [
        "./dist/types/architect/server/index.d.ts"
      ],
      "kenney": [
        "./dist/types/kenney/index.d.ts"
      ],
      "gas": [
        "./dist/types/gas/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vespenelabs-floorview.js",
      "require": "./dist/vespenelabs-floorview.umd.cjs"
    },
    "./model": {
      "types": "./dist/types/model/index.d.ts",
      "import": "./dist/model.js",
      "require": "./dist/model.cjs"
    },
    "./architect": {
      "types": "./dist/types/architect/index.d.ts",
      "import": "./dist/architect.js",
      "require": "./dist/architect.cjs"
    },
    "./architect/server": {
      "types": "./dist/types/architect/server/index.d.ts",
      "import": "./dist/architect/server.js",
      "require": "./dist/architect/server.cjs"
    },
    "./kenney": {
      "types": "./dist/types/kenney/index.d.ts",
      "import": "./dist/kenney.js",
      "require": "./dist/kenney.cjs"
    },
    "./gas": {
      "types": "./dist/types/gas/index.d.ts",
      "import": "./dist/gas.js",
      "require": "./dist/gas.cjs"
    },
    "./style.css": "./dist/vespenelabs-floorview.css",
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "dev": "vite studio",
    "dev:mock": "ARCHITECT_MOCK=1 vite studio",
    "build": "vite build && vite build --mode subpaths && tsc -p tsconfig.build.json",
    "build:studio": "vite build studio",
    "preview:studio": "vite preview studio",
    "typecheck": "tsc --noEmit && tsc --noEmit -p studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "three": ">=0.160.0",
    "@anthropic-ai/sdk": ">=1.4.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
